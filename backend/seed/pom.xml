<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexto seed: depende de comum-aws (ordem: contextos -> comum-aws -> dominio). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>br.mp.mpf.sisgares</groupId>
    <artifactId>sisgares-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>seed</artifactId>
  <name>SISGARES - Seed</name>
  <dependencies>
    <!-- contexto -> comum-aws (que traz dominio transitivamente) -->
    <dependency>
      <groupId>br.mp.mpf.sisgares</groupId>
      <artifactId>comum-aws</artifactId>
    </dependency>
    <!-- Leitura dos CSVs/imagens e gravação do relatório (versão pelo BOM software.amazon.awssdk:bom) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <!-- Interface RequestHandler da Lambda (versão no pom pai) -->
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-core</artifactId>
    </dependency>
  </dependencies>
</project>
