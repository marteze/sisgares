# Porta da API
PORT=3001

# Origem permitida para CORS (frontend em dev)
CORS_ORIGIN=http://localhost:5173

# AWS Cognito (preencher no ambiente final; em dev usamos mock)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# Modo de autenticação: "mock" (dev) ou "cognito"
AUTH_MODE=mock
