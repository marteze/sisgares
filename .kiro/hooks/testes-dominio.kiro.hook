{
  "enabled": true,
  "name": "Testes do domínio",
  "description": "Executa os testes do Núcleo_Domínio (módulo Maven dominio) sempre que um arquivo Java de backend/dominio for salvo (Requisito 19.3).",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/dominio/**/*.java"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home mvn -q -f backend/pom.xml -pl dominio test"
  }
}
